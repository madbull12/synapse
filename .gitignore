# ==========================================
# System & Editor Junk
# ==========================================
.DS_Store
.DS_Store?
*_local
Thumbs.db
.vscode/
!.vscode/settings.json # Keep settings.json so Go workspace support works for everyone

# ==========================================
# Client (Next.js & pnpm)
# ==========================================
client/node_modules/
client/.next/
client/out/
client/build/
client/dist/
client/next-env.d.ts
client/*.tsbuildinfo

# pnpm specific
client/.pnpm-debug.log*
pnpm-debug.log*

# ==========================================
# Server (Go Backend)
# ==========================================
# Compiled binaries
server/bin/
server/cmd/api/api # If you build local executables here
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test coverage
server/coverage.txt
server/profile.out

# ==========================================
# Environments & Secrets (CRITICAL)
# ==========================================
# Never commit your private keys or DB credentials
.env
.env.*
!.env.example # Allow committing placeholder files
server/.env
server/.env.*
client/.env
client/.env.*

# ==========================================
# Misc / Debug Logs
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/coverage